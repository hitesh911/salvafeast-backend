DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=salva
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=changeme
PLATFORM_ADMIN_NAME=Platform Admin
GCS_BUCKET_NAME=your-gcs-bucket-name
# Optional: local/dev JSON key only. Cloud Run uses ADC (runtime SA) — leave empty there.
GCS_SERVICE_ACCOUNT_JSON_PATH=
# Optional project / signing SA email for ADC signed URLs on Cloud Run
GCS_PROJECT_ID=
GCS_SIGNING_SERVICE_ACCOUNT=
GCS_SIGNED_URL_EXPIRE_MINUTES=15
# SALVA_ENV=local → files go to local_media/ (no GCS needed)
LOCAL_MEDIA_DIR=local_media
LOCAL_MEDIA_BASE_URL=http://localhost:8000/local-media
# Public customer order/menu site (QR links, etc.). Local dev: http://localhost:3001
CONSUMER_WEB_BASE_URL=https://order.salva.app
CONSUMER_JWT_EXPIRE_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key goes in salva-consumer-web NEXT_PUBLIC_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=BGlnxrMjoQVCF6xw1sZIXgWj0llnJKCdcg3JgG-8KAjzwsIy_cWlLn9od02EBBq3ps74WbOByEylBgt9hw2JAwE
VAPID_PRIVATE_KEY=G4HpE-W7PD8C6uJjwexPB7OUI1CGfRjcYalaQOs_tRc
VAPID_CONTACT_EMAIL=support@salva.app

SMS_PROVIDER=console
# WhatsApp OTP via Fast2SMS (only when SMS_PROVIDER=whatsapp)
# FAST2SMS_AUTH_KEY=
# FAST2SMS_PHONE_NUMBER_ID=
# FAST2SMS_MESSAGE_ID=

# Runtime environment mode:
# - local: never send OTP externally (prints OTP to backend console)
# - dev: use SMS_PROVIDER
# - production: use SMS_PROVIDER
SALVA_ENV=local
